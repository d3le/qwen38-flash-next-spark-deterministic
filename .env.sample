# Copy to .env and edit.  Everything else lives under QWEN38_ROOT.
QWEN38_ROOT=$HOME/qwen38
# BASE_DIR=$HOME/qwen38/nvidia-base   # reuse an existing download of nvidia/Qwen3.8-Flash-Next-NVFP4
# IMAGE=ghcr.io/d3le/qwen38-flash-next-spark-deterministic:v0.1
# PORT=30000
# HOST=127.0.0.1                       # 0.0.0.0 to serve other machines
# SPEC_STEPS=3                         # 4: faster on long/code output, slower on chat (outputs identical)
# HF_TOKEN=                            # only if Hugging Face asks for one
